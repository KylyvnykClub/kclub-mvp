{
  "name": "@kclub/database",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/seeds/run-seed.ts",
    "db:seed:plan": "bun run src/seeds/seed-plan.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@kclub/config": "workspace:*",
    "@types/bun": "^1.3.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3"
  }
}

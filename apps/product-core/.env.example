# Product Core — Environment Variables
#
# Copy this file to `.env.local` and fill in the values.
# See docs/ENVIRONMENT.md for the authoritative description of every variable.
# Values marked [required in production] are enforced at server startup (see src/instrumentation.ts).

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public base URL of this app. [required in production]
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public site URL used for SEO/sitemap. Falls back to https://kylyvnyk.club.
NEXT_PUBLIC_SITE_URL=
# Base URL of the admin-app (used for cross-app links).
ADMIN_APP_URL=http://localhost:3001
# Logger verbosity: error | warn | info | debug (defaults to info).
LOG_LEVEL=

# ---------------------------------------------------------------------------
# Database — Supabase Postgres via Drizzle
# ---------------------------------------------------------------------------
# Pooled connection used by the running app. [required in production]
DATABASE_URL=postgres://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:6543/postgres?pgbouncer=true&connection_limit=10
# Direct (non-pooled) connection used by migrations (drizzle-kit migrate).
DATABASE_URL_DIRECT=postgres://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres
# Optional. Disposable DB only for `pnpm test:db`; the database name must contain test, ci, or scratch.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication — Supabase Auth (phone-first)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
# Anon (publishable) client key. [required in production]
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
# Service-role key for server-side privileged calls. Never expose to the browser. [required in production]
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Local/demo only. Production ignores these flags even if set (see dev-phone-bypass-config.ts).
AUTH_DEV_PHONE_BYPASS_ENABLED=
# Required when phone bypass is enabled outside tests (min 8 chars). Use 4-8 digits to override the default OTP.
AUTH_DEV_PHONE_BYPASS_SECRET=
AUTH_DEV_2FA_BYPASS_ENABLED=

# ---------------------------------------------------------------------------
# Staff / Admin auth
# ---------------------------------------------------------------------------
# Bootstrap the first OWNER (phone + password sign-in, skips TOTP).
ADMIN_BOOTSTRAP_OWNER_PHONE=
ADMIN_BOOTSTRAP_OWNER_PASSWORD=
# Secret for signing staff session JWTs (min 32 chars). [required in production]
ADMIN_JWT_SECRET=REPLACE_ME_32_CHARS_MINIMUM
# AES-256-GCM key for encrypting staff TOTP secrets at rest (base64, 32 bytes). [required in production]
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=REPLACE_ME
# Force the rate-limit backend to be required (auto-on in production).
STAFF_AUTH_RATE_LIMIT_REQUIRED=

# ---------------------------------------------------------------------------
# Billing — Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME                 # [required in production]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME # [required in production]
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME               # [required in production]
# Checkout reads admin_config first; these env vars are fallbacks for local dev.
STRIPE_PRICE_VIP_MEMBERSHIP_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_BUSINESS_PLACEMENT_MONTHLY=price_REPLACE_ME
# Legacy aliases still honored by the checkout fallback:
STRIPE_PRICE_VIP_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_BUSINESS_ANNUAL=price_REPLACE_ME
STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE_ME

# ---------------------------------------------------------------------------
# Cron — Vercel scheduled daily maintenance
# ---------------------------------------------------------------------------
# Bearer token Vercel Cron attaches to /api/cron/daily-maintenance. [required in production]
CRON_SECRET=REPLACE_ME

# ---------------------------------------------------------------------------
# Rate limiting — Upstash Redis
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ---------------------------------------------------------------------------
# Analytics — Plausible (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------------------------------------------------------------------------
# Internal flags / seeding (never enable the seed flags in production)
# ---------------------------------------------------------------------------
ALLOW_SEED=
CONFIRM_SEED=

# ---------------------------------------------------------------------------
# E2E testing — enables the test seed/teardown API routes (never set in production)
# ---------------------------------------------------------------------------
E2E_TEST_SECRET=

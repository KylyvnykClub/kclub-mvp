# Admin App — Environment Variables
#
# Copy this file to `.env.local` and fill in the values.
# See docs/ENVIRONMENT.md for the authoritative description of every variable.

NODE_ENV=development

# Base URL of the product-core API this admin console talks to.
PRODUCT_CORE_API_BASE_URL=http://localhost:3000
# Admin-scoped API base on product-core (server-to-server calls). [required in production]
PRODUCT_CORE_ADMIN_API_URL=http://localhost:3000

# Logger verbosity: error | warn | info | debug (defaults to info).
LOG_LEVEL=

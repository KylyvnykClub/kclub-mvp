{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "DATABASE_URL_DIRECT",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SECRET",
        "STRIPE_SECRET_KEY",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PRICE_VIP_MEMBERSHIP_MONTHLY",
        "STRIPE_PRICE_BUSINESS_PLACEMENT_MONTHLY",
        "STRIPE_PRICE_VIP_ANNUAL",
        "STRIPE_PRICE_BUSINESS_ANNUAL",
        "STRIPE_PORTAL_CONFIGURATION_ID",
        "CRON_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN",
        "ADMIN_APP_URL",
        "ADMIN_BOOTSTRAP_OWNER_PHONE",
        "ADMIN_JWT_SECRET",
        "ADMIN_STAFF_DEV_OTP",
        "ADMIN_STAFF_DEV_TOTP",
        "EMAIL_PROVIDER_API_KEY",
        "EMAIL_FROM_ADDRESS",
        "LOG_LEVEL",
        "AUTH_DEV_PHONE_BYPASS_ENABLED",
        "AUTH_DEV_PHONE_BYPASS_SECRET",
        "AUTH_DEV_2FA_BYPASS_ENABLED",
        "ALLOW_SEED",
        "CONFIRM_SEED",
        "DISABLE_VOCAB_GREP",
        "E2E_TEST_SECRET",
        "NEXT_PUBLIC_ADMIN_APP_URL",
        "PRODUCT_CORE_API_BASE_URL",
        "TOTP_ENCRYPTION_KEY",
        "APP_ENV"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}

{
  "name": "kclub-mvp-v4",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:contracts": "turbo run test --filter=@kclub/contracts --filter=@kclub/test-utils",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:product-core": "playwright test --project=product-core",
    "e2e:admin-app": "playwright test --project=admin-app",
    "theme-guard": "node scripts/theme-guard.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.1.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
